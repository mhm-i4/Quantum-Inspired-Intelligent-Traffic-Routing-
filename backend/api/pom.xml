<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.qpso.traffic</groupId>
        <artifactId>qpso-traffic-optimization-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>api</artifactId>
    <packaging>jar</packaging>
    <name>REST API (Spring Boot)</name>
    <description>
        Spring Boot application exposing REST endpoints for
        network, traffic, routing, optimization and benchmarking.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qpso.traffic</groupId>
            <artifactId>graph</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.qpso.traffic</groupId>
            <artifactId>traffic</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.qpso.traffic</groupId>
            <artifactId>routing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.qpso.traffic</groupId>
            <artifactId>constraints</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.qpso.traffic</groupId>
            <artifactId>optimization</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.qpso.traffic</groupId>
            <artifactId>qpso</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.qpso.traffic</groupId>
            <artifactId>pso</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.qpso.traffic</groupId>
            <artifactId>ga</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.qpso.traffic</groupId>
            <artifactId>benchmarking</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.qpso.traffic</groupId>
            <artifactId>simulation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
